# Copy to .env (git-ignored): cp .env.example .env
# The values below are throwaway local-dev defaults, not secrets. Real deployments get
# their own values from the deployment environment, never from this file.
DB_PASSWORD=changeme
DB_PORT=5432
FRONTEND_PORT=4200

# Must be non-empty or compose refuses to start (${JWT_SECRET:?} in docker-compose.yml).
# Local-dev value only - anything sharing this secret can mint valid tokens.
JWT_SECRET=local-dev-only-jwt-secret-not-for-any-real-environment
