# Copy to .env (git-ignored): cp .env.example .env
# The values below are throwaway local-dev defaults, not secrets. Real deployments get
# their own values from the deployment environment, never from this file.
DB_PASSWORD=changeme
DB_PORT=5432
FRONTEND_PORT=4200
MAILPIT_UI_PORT=8025
# The page the emailed password reset link opens. Set it when the browser reaches the frontend
# on something other than http://localhost:${FRONTEND_PORT}.
# PASSWORD_RESET_LINK_BASE_URL=http://my-host:4200/reset-password
# Inactive account check (and its emails); nightly at 02:00 UTC unless set. Uncomment to run it
# every 2 minutes locally - see the Mailpit notes in the README.
# ACCOUNT_INACTIVITY_CRON=0 */2 * * * *

# Persistent deployments: first identify the EXISTING PostgreSQL volume using
# docs/trade-record-resilience.md. Requires Docker Compose v2.
# DB_VOLUME_NAME=replace-with-existing-volume-name
# DB_VOLUME_EXTERNAL=true

# Uncomment to use a PostgreSQL outside Docker (e.g. the Windows host's) instead of the bundled
# db container - see "Using an external PostgreSQL" in the README.
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml
# EXTERNAL_DB_HOST=192.168.1.50
# EXTERNAL_DB_PORT=5432

# Must be non-empty or compose refuses to start (${JWT_SECRET:?} in docker-compose.yml).
# Local-dev value only - anything sharing this secret can mint valid tokens.
JWT_SECRET=
