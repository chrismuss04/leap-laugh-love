# Copy to .env (git-ignored) to point the suite somewhere other than the defaults.
# The frontend; every API call goes through its dev-server proxy.
BASE_URL=http://localhost:4200
# The mail catcher's web UI/API. Registering a user means following the link iam-app emails.
MAILPIT_URL=http://localhost:8025
# Password shared by every seeded user (seed_iam.sql, e2e_seed.sql).
E2E_PASSWORD=Password123!
